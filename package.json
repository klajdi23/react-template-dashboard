{
 "name": "project-template-dashboard",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-brands-svg-icons": "^6.4.2",
    "@fortawesome/free-regular-svg-icons": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.0.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.10.5",
    "axios": "^1.6.2",
    "cra-template-typescript": "1.2.0",
    "date-fns": "^4.1.0",
    "formik": "^2.4.6",
    "framer-motion": "^12.5.0",
    "moment": "^2.30.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-fullscreen-loading": "^0.0.4",
    "react-redux": "^9.0.4",
    "react-router": "^7.4.0",
    "react-router-dom": "^7.4.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^3.5.0",
    "yup": "^1.6.1",
    "yup-password": "^0.4.0"
  },
  "scripts": {
    "start": "env-cmd -f .env/.env react-scripts --max_old_space_size=10240 start",
    "start-dev": "env-cmd -f .env/.env.dev react-scripts --max_old_space_size=10240 start",
    "start-qa": "env-cmd -f .env/.env.qa react-scripts --max_old_space_size=10240 start",
    "start-internal": "env-cmd -f .env/.env.internal react-scripts --max_old_space_size=10240 start",
    "start-prod": "env-cmd -f .env/.env.prod react-scripts --max_old_space_size=10240 start",
    "build-dev": "env-cmd -f .env/.env.dev react-scripts --max_old_space_size=10240 build",
    "build-qa": "env-cmd -f .env/.env.qa react-scripts --max_old_space_size=10240 build",
    "build-internal": "env-cmd -f .env/.env.internal react-scripts --max_old_space_size=10240 build",
    "build-prod": "env-cmd -f .env/.env.prod react-scripts --max_old_space_size=10240 build",
    "build": "react-scripts --max_old_space_size=10240 build",
    "test": "react-scripts test --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|axios-mock-adapter)/)"
    ],
    "moduleNameMapper": {
      "^axios$": "<rootDir>/node_modules/axios/dist/axios.js"
    }
  }
}
